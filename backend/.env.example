# Copy to .env and adjust as needed
APP_NAME=KingUnderTheMountain
ENV=dev
# Optional override read by runtime validation; use dev/test/prod
APP_ENV=dev

# SECURITY: change these for real deployments
JWT_SECRET=dev_change_me
JWT_ALG=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOGIN_LOCKOUT_ENABLED=0
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15
KUTM_IDEMPOTENCY_ENFORCE=
KUTM_IDEMPOTENCY_EXEMPT_PATHS=/api/v1/auth/login,/api/v1/auth/refresh,/api/v1/ops/bootstrap
KUTM_IDEMPOTENCY_KEY_RETENTION_DAYS=30
KUTM_DMS_REQUIRE_IF_MATCH=1
KUTM_RATE_LIMIT_BACKEND=auto
KUTM_DB_POOL_SIZE=20
KUTM_DB_MAX_OVERFLOW=40
KUTM_DB_POOL_TIMEOUT_SECONDS=30
KUTM_DB_POOL_RECYCLE_SECONDS=1800

# Postgres
DB_HOST=127.0.0.1
DB_PORT=5440
DB_NAME=kutm
DB_USER=kutm
DB_PASSWORD=password

# Dev seed/smoke credentials (override as needed)
KUTM_SEED_TENANT=Default
KUTM_SEED_EMAIL=you@example.com
KUTM_SEED_PASSWORD=Password123!

# Integrations hardening
KUTM_WEBHOOK_ALLOW_PRIVATE_HOSTS=0

# IO import safety
KUTM_IO_IMPORT_MAX_BYTES=5242880

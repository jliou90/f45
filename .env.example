# Compose-level defaults
APP_ENV=dev
ENV=dev
APP_NAME=KingUnderTheMountain

# Security
# In APP_ENV=prod, JWT_SECRET must be >= 32 chars and not a placeholder.
JWT_SECRET=dev_change_me
JWT_ALG=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOGIN_LOCKOUT_ENABLED=0
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15
# Leave empty unless you intentionally enable bootstrap flow.
BOOTSTRAP_TOKEN=

# Host hardening (comma-separated)
TRUSTED_HOSTS=kutm.local,localhost,127.0.0.1
KUTM_HOSTNAME=kutm.local

KUTM_IDEMPOTENCY_ENFORCE=
KUTM_IDEMPOTENCY_EXEMPT_PATHS=/api/v1/auth/login,/api/v1/auth/refresh,/api/v1/ops/bootstrap
KUTM_DMS_REQUIRE_IF_MATCH=1
UVICORN_WORKERS=4
KUTM_RATE_LIMIT_BACKEND=auto
KUTM_DB_POOL_SIZE=20
KUTM_DB_MAX_OVERFLOW=40
KUTM_DB_POOL_TIMEOUT_SECONDS=30
KUTM_DB_POOL_RECYCLE_SECONDS=1800
KUTM_FLAG_COMMS_ENABLED=true
KUTM_FLAG_ACCOUNTING_BETA=false
KUTM_FLAG_REALTIME_ENABLED=false
KUTM_FLAG_PDF_EXPORT_ENABLED=true
KUTM_BACKUP_SCHEDULE_ENABLED=0
KUTM_BACKUP_SCHEDULE_INTERVAL_MINUTES=1440
KUTM_BACKUP_RETENTION_COUNT=14
KUTM_RESTORE_CONFIRM_PHRASE=RESTORE_KUTM

# Frontend API base must stay relative for single-origin deploy.
VITE_API_BASE_URL=/api/v1

# Optional first-run seed (idempotent). Leave empty to disable.
KUTM_SEED_TENANT=
KUTM_SEED_EMAIL=
KUTM_SEED_PASSWORD=
KUTM_SEED_FORCE_PASSWORD=false

# Postgres
POSTGRES_DB=kutm
POSTGRES_USER=kutm
POSTGRES_PASSWORD=password

# LAN HTTPS host ports
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# mkcert output paths (repo-ignored)
TLS_CERT_FILE=./secrets/tls/kutm.local+3.pem
TLS_KEY_FILE=./secrets/tls/kutm.local+3-key.pem

# Optional pgAdmin (docker compose --profile dev up)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_HOST_PORT=5050

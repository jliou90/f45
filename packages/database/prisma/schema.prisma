// ============================================================================
// DMS PLATFORM - MAIN PRISMA SCHEMA
// ============================================================================
// This file imports all domain-specific schemas for better organization
// Each domain (auth, customers, service, parts, sales) has its own schema file
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// DOMAIN SCHEMAS
// ============================================================================
// Import all domain-specific schemas
// Schemas are organized by business domain for better maintainability
// ============================================================================

// Core models: Organizations, Locations, Users, Auth, Permissions
// Located in: schema/base.prisma
// Models: Organization, Location, User, Session, RefreshToken, Permission, Role, RolePermission

// Customer domain: Customers, Vehicles, Touchpoints
// Located in: schema/customers.prisma  
// Models: Customer, Vehicle, CustomerTouchpoint

// Service domain: Appointments, Work Orders, Quotes
// Located in: schema/service.prisma
// Models: Appointment, WorkOrder, WorkOrderItem, Quote, QuoteItem

// Parts domain: Inventory, Vendors, Purchase Orders
// Located in: schema/parts.prisma
// Models: Part, PartTransaction, Vendor, PurchaseOrder, PurchaseOrderItem

// Sales & Communications domain: Leads, Deals, F&I, Communications
// Located in: schema/sales.prisma
// Models: Lead, VehicleInventory, Deal, FIProduct, Communication

// ============================================================================
// NOTES:
// ============================================================================
// - Run `npm run generate` to generate the Prisma Client
// - Run `npm run migrate` to create/update database schema
// - Run `npm run studio` to open Prisma Studio GUI
// - All models use UUID for primary keys
// - All models have createdAt/updatedAt timestamps
// - Soft deletes can be added later if needed
// - Indexes are added for frequently queried fields
// ============================================================================


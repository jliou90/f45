// ============================================================================
// SALES & F&I DOMAIN MODELS
// ============================================================================

/// Sales Lead
model Lead {
  id             String   @id @default(uuid())
  organizationId String
  
  // Lead source
  source         String?  // 'website' | 'phone' | 'walk_in' | 'referral' | 'social'
  sourceDetail   String?
  
  // Contact info
  firstName      String
  lastName       String
  email          String?
  phone          String?
  
  // Interest
  interestedIn   String?  // 'new' | 'used' | 'lease' | 'trade_in'
  vehicleInterest Json?   // { make, model, year, trim }
  budgetRange    String?
  
  // Timeline
  timeframe      String?  // 'immediate' | 'this_week' | 'this_month' | 'just_looking'
  
  // Status
  status         String   @default("new") // 'new' | 'contacted' | 'qualified' | 'negotiating' | 'won' | 'lost'
  
  // Assignment
  assignedToId   String?
  
  // Conversion
  convertedToDealId String?
  convertedAt    DateTime?
  
  // Loss tracking
  lostReason     String?
  lostAt         DateTime?
  
  // Metadata
  notes          String?  @db.Text
  customFields   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@map("leads")
  @@index([organizationId])
  @@index([status])
  @@index([email])
  @@index([phone])
}

/// Vehicle Inventory (for sales)
model VehicleInventory {
  id             String   @id @default(uuid())
  organizationId String
  
  // Stock number
  stockNumber    String   @unique
  
  // Vehicle identification
  vin            String   @unique
  year           Int
  make           String
  model          String
  trim           String?
  
  // Details
  bodyStyle      String?
  engine         String?
  transmission   String?
  drivetrain     String?
  exteriorColor  String?
  interiorColor  String?
  mileage        Int
  
  // Condition
  condition      String   // 'new' | 'used' | 'certified'
  
  // Pricing
  cost           Decimal  @db.Decimal(10, 2)
  msrp           Decimal? @db.Decimal(10, 2)
  sellingPrice   Decimal  @db.Decimal(10, 2)
  
  // Floor plan
  isFloorPlanned Boolean  @default(false)
  floorPlanProvider String?
  floorPlanAmount Decimal? @db.Decimal(10, 2)
  floorPlanDate  DateTime?
  
  // Dates
  purchaseDate   DateTime?
  inStockDate    DateTime  @default(now())
  soldDate       DateTime?
  daysInStock    Int       @default(0)
  
  // Status
  status         String    @default("available") // 'available' | 'hold' | 'sold' | 'wholesale'
  
  // Location
  lotLocation    String?
  
  // Features (JSON array)
  features       Json?
  
  // Photos
  photos         Json?    // Array of photo URLs
  
  // Online listing
  isOnline       Boolean  @default(false)
  onlineViews    Int      @default(0)
  onlineLeads    Int      @default(0)
  
  // Metadata
  notes          String?  @db.Text
  customFields   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@map("vehicle_inventory")
  @@index([organizationId])
  @@index([stockNumber])
  @@index([vin])
  @@index([status])
}

/// Deal (Sales transaction)
model Deal {
  id             String   @id @default(uuid())
  organizationId String
  customerId     String
  vehicleInventoryId String?
  
  // Deal number
  dealNumber     String   @unique
  
  // Type
  dealType       String   // 'retail' | 'lease' | 'wholesale'
  
  // Vehicle sold
  soldVehicle    Json?    // Complete vehicle details
  
  // Trade-in
  hasTradeIn     Boolean  @default(false)
  tradeInVehicle Json?
  tradeInValue   Decimal? @db.Decimal(10, 2)
  tradeInPayoff  Decimal? @db.Decimal(10, 2)
  
  // Pricing
  vehiclePrice   Decimal  @db.Decimal(10, 2)
  addOns         Decimal  @default(0) @db.Decimal(10, 2)
  discounts      Decimal  @default(0) @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
  taxesAndFees   Decimal  @db.Decimal(10, 2)
  total          Decimal  @db.Decimal(10, 2)
  
  // Down payment
  downPayment    Decimal  @default(0) @db.Decimal(10, 2)
  amountFinanced Decimal  @db.Decimal(10, 2)
  
  // Status
  status         String   @default("pending") // 'pending' | 'approved' | 'funded' | 'delivered' | 'unwound'
  
  // Delivery
  deliveryDate   DateTime?
  
  // Metadata
  notes          String?  @db.Text
  customFields   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id])
  
  @@map("deals")
  @@index([organizationId])
  @@index([customerId])
  @@index([dealNumber])
  @@index([status])
}

/// F&I Product (Finance & Insurance products)
model FIProduct {
  id             String   @id @default(uuid())
  organizationId String
  
  // Product details
  name           String
  category       String   // 'warranty' | 'gap' | 'maintenance' | 'protection' | 'insurance'
  provider       String?
  
  // Description
  description    String?  @db.Text
  coverage       String?  @db.Text
  terms          String?  @db.Text
  
  // Pricing
  cost           Decimal  @db.Decimal(10, 2)
  retailPrice    Decimal  @db.Decimal(10, 2)
  
  // Commission
  commissionRate Decimal? @db.Decimal(5, 2) // Percentage
  
  // Status
  isActive       Boolean  @default(true)
  
  // Metadata
  customFields   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@map("fi_products")
  @@index([organizationId])
  @@index([category])
}

// ============================================================================
// COMMUNICATIONS DOMAIN MODELS
// ============================================================================

/// Communication (Email, SMS, Phone log)
model Communication {
  id             String   @id @default(uuid())
  organizationId String
  customerId     String
  
  // Type
  type           String   // 'email' | 'sms' | 'phone' | 'chat'
  direction      String   // 'inbound' | 'outbound'
  
  // Content
  subject        String?
  message        String?  @db.Text
  
  // Email specifics
  from           String?
  to             String?
  cc             String?
  bcc            String?
  
  // Phone specifics
  phoneNumber    String?
  duration       Int?     // seconds
  
  // Status
  status         String?  // 'sent' | 'delivered' | 'failed' | 'bounced' | 'opened' | 'clicked'
  
  // Tracking
  sentAt         DateTime?
  deliveredAt    DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  
  // Metadata
  metadata       Json?
  createdAt      DateTime @default(now())
  
  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  @@map("communications")
  @@index([organizationId])
  @@index([customerId])
  @@index([type])
  @@index([createdAt])
}
